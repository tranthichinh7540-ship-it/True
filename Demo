local isUnlocked = false
local basePos1 = UDim2.new(0, 12, 0, TOP_H + (KEY_H - TOP_H - 8) - (barHeight + barBottomMargin + imgSize))
local basePos2 = UDim2.new(0, 70, 0, TOP_H + (KEY_H - TOP_H - 8) - (barHeight + barBottomMargin + imgSize))

local function syncImagePositions()
	if not isUnlocked then
		basePos1 = UDim2.new(0, 12, 0, TOP_H + (KEY_H - TOP_H - 8) - (barHeight + barBottomMargin + imgSize))
		basePos2 = UDim2.new(0, 70, 0, TOP_H + (KEY_H - TOP_H - 8) - (barHeight + barBottomMargin + imgSize))
	else
		basePos1 = UDim2.new(0, 12, 0, -imgSize)
		basePos2 = UDim2.new(0, 70, 0, -imgSize)
	end
	imgBtn1.Position = basePos1
	imgBtn2.Position = basePos2
end

syncImagePositions()

local function bindBounce(btn, getBase)
	local currentTween = nil
	local clickToken = 0

	btn.MouseButton1Click:Connect(function()
		clickToken += 1
		local myToken = clickToken
		local base = getBase()

		if currentTween then
			currentTween:Cancel()
		end

		local targetPos = UDim2.new(
			base.X.Scale,
			base.X.Offset,
			base.Y.Scale,
			base.Y.Offset - jumpHeight
		)

		currentTween = TweenService:Create(btn, TweenInfo.new(0.11, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = targetPos
		})
		currentTween:Play()

		task.delay(0.11, function()
			if myToken == clickToken then
				currentTween = TweenService:Create(btn, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
					Position = getBase()
				})
				currentTween:Play()
			end
		end)
	end)
end

bindBounce(imgBtn1, function() return basePos1 end)
bindBounce(imgBtn2, function() return basePos2 end)

local function unlockMainGui()
	if isUnlocked then return end
	isUnlocked = true
	keyScreen.Visible = false
	mainHub.Visible = true

	outerRoot.Size = UDim2.new(0, MAIN_W, 0, MAIN_H)
	outerRoot.Position = UDim2.new(0.5, -MAIN_W / 2, 0.5, -MAIN_H / 2 + 16)
	syncImagePositions()
end

keyBarBox.FocusLost:Connect(function()
	if keyBarBox.Text == REQUIRED_KEY then
		keyBarStroke.Color = Color3.fromRGB(95, 200, 130)
		unlockMainGui()
	else
		keyBarStroke.Color = Color3.fromRGB(220, 95, 95)
	end
end)

local minimized = false
minBtn.MouseButton1Click:Connect(function()
	playClickSound()
	minimized = not minimized
	contentFrame.Visible = not minimized
	if minimized then
		mainFrame.Size = UDim2.new(1, 0, 0, TOP_H)
	else
		mainFrame.Size = UDim2.new(1, 0, 1, 0)
	end
end)

closeBtn.MouseButton1Click:Connect(function()
	playClickSound()
	task.delay(0.08, function()
		screenGui:Destroy()
	end)
end)
