local function switchTab(target)
	playClickSound()
	pulseButton(target == "Home" and homeTabBtn or settingTabBtn)

	homePage.Visible = (target == "Home")
	settingPage.Visible = (target == "Setting")

	TweenService:Create(
		homeTabBtn,
		TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ BackgroundColor3 = (target == "Home") and Color3.fromRGB(48, 53, 68) or Color3.fromRGB(33, 36, 45) }
	):Play()

	TweenService:Create(
		settingTabBtn,
		TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ BackgroundColor3 = (target == "Setting") and Color3.fromRGB(48, 53, 68) or Color3.fromRGB(33, 36, 45) }
	):Play()

	animatePageIn(target == "Home" and homePage or settingPage)
end

