local function applyCustomGuiColor(col)
    Theme.Background = col
    Theme.Surface = mix(col,Color3.fromRGB(255,255,255),0.055)
    Theme.Card = mix(col,Color3.fromRGB(255,255,255),0.095)
    Theme.TopBar = mix(col,Color3.fromRGB(0,0,0),0.10)
    Theme.Border = mix(col,Color3.fromRGB(145,165,205),0.23)

    local info = TweenInfo.new(
        0.25,
        Enum.EasingStyle.Quart,
        Enum.EasingDirection.Out
    )

    local function set(obj,color)
        tween(obj,0.25,{BackgroundColor3=color})
    end

    set(mainFrame,Theme.Background)
    set(contentFrame,Theme.Surface)
    set(topBar,Theme.TopBar)
    set(topFix,Theme.TopBar)
    set(sidebar,Theme.Card)
    set(pageArea,Theme.Surface)
    set(colorCard,Theme.Card)
    set(welcomeCard,Theme.Card)
    set(customColorBox,Theme.Background)

    mainStroke.Color = Theme.Border
    contentStroke.Color = Theme.Border

    for _,obj in ipairs({
        sidebar,pageArea,colorCard,welcomeCard
    }) do
        local s = obj:FindFirstChildOfClass("UIStroke")
        if s then s.Color = Theme.Border end
    end

    settingPage.ScrollBarImageColor3 = Theme.Accent
end

local function parseColorInput(str)
    local clean = str:gsub("%s","")

    if clean:sub(1,1) == "#" and #clean == 7 then
        local r = tonumber(clean:sub(2,3),16)
        local g = tonumber(clean:sub(4,5),16)
        local b = tonumber(clean:sub(6,7),16)

        if r and g and b then
            return Color3.fromRGB(r,g,b)
        end
    end

    local r,g,b = clean:match("^(%d+),(%d+),(%d+)$")

    if r and g and b then
        return Color3.fromRGB(
            math.clamp(tonumber(r),0,255),
            math.clamp(tonumber(g),0,255),
            math.clamp(tonumber(b),0,255)
        )
    end
end

