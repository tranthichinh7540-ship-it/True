local function parseColorInput(str)
	local clean = str:gsub("^%s+", ""):gsub("%s+$", "")
	if clean:sub(1, 1) == "#" and #clean == 7 then
		local r = tonumber(clean:sub(2, 3), 16)
		local g = tonumber(clean:sub(4, 5), 16)
		local b = tonumber(clean:sub(6, 7), 16)
		if r and g and b then
			return Color3.fromRGB(r, g, b)
		end
	end
	local rStr, gStr, bStr = clean:match("^(%d+)%s*,%s*(%d+)%s*,%s*(%d+)$")
	if rStr and gStr and bStr then
		return Color3.fromRGB(
			math.clamp(tonumber(rStr), 0, 255),
			math.clamp(tonumber(gStr), 0, 255),
			math.clamp(tonumber(bStr), 0, 255)
		)
	end
	return nil
end

customColorBox.FocusLost:Connect(function()
