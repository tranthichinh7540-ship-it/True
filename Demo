local function setTab(target)
    local isHome = target == "Home"

    homePage.Visible = isHome
    settingPage.Visible = not isHome

    homeIndicator.Visible = isHome
    settingIndicator.Visible = not isHome

    tween(homeTabBtn,0.18,{
        BackgroundColor3 = isHome
            and Theme.AccentDark
            or Theme.Card
    })

    tween(settingTabBtn,0.18,{
        BackgroundColor3 = not isHome
            and Theme.AccentDark
            or Theme.Card
    })

    homeText.TextColor3 = isHome and Theme.Text or Theme.Muted
    settingText.TextColor3 = not isHome and Theme.Text or Theme.Muted

    homeIcon.ImageColor3 = isHome and Theme.Accent or Theme.Muted
    settingIcon.ImageColor3 = not isHome and Theme.Accent or Theme.Muted

    playClickSound()
end

