	end
	if not imgBtn2.IsLoaded then
		imgBtn2.Image = "rbxthumb://type=Asset&id=131733394534816&w=420&h=420"
	end
end)

local state1 = {
	offset = 0,
	phase = "idle",
	timer = 0,
	startOffset = 0,
}

local state2 = {
	offset = 0,
	phase = "idle",
	timer = 0,
	startOffset = 0,
}

local function getAnchorLocalY()
	if not isUnlocked then
		return TOP_H + (KEY_H - TOP_H - 8) - (barHeight + barBottomMargin + imgSize)
	else
		return -imgSize
	end
end

local function stepImageMotion(st, dt)
	if st.phase == "rising" then
		st.timer += dt
		local alpha = math.clamp(st.timer / riseDuration, 0, 1)
		local eased = 1 - (1 - alpha) * (1 - alpha)
		st.offset = st.startOffset + (jumpHeight - st.startOffset) * eased
		if alpha >= 1 then
			st.offset = jumpHeight
			st.phase = "falling"
			st.timer = 0
			st.startOffset = jumpHeight
		end
	elseif st.phase == "falling" then
		st.timer += dt
		local alpha = math.clamp(st.timer / fallDuration, 0, 1)
		local eased = alpha * alpha * (3 - 2 * alpha)
		st.offset = st.startOffset * (1 - eased)
		if alpha >= 1 then
			st.offset = 0
			st.phase = "idle"
			st.timer = 0
		end
	end
end

local function triggerImageJump(st)
	st.phase = "rising"
	st.timer = 0
	st.startOffset = st.offset
end

RunService.RenderStepped:Connect(function(dt)
	stepImageMotion(state1, dt)
	stepImageMotion(state2, dt)

	if minimized then
		imgBtn1.Visible = false
		imgBtn2.Visible = false
		return
	end

	imgBtn1.Visible = true
	imgBtn2.Visible = true

	local absPos = mainFrame.AbsolutePosition
	local baseY = absPos.Y + getAnchorLocalY()
	imgBtn1.Position = UDim2.fromOffset(absPos.X + 20, math.floor(baseY - state1.offset + 0.5))
	imgBtn2.Position = UDim2.fromOffset(absPos.X + 78, math.floor(baseY - state2.offset + 0.5))
end)

imgBtn1.MouseButton1Click:Connect(function()
	triggerImageJump(state1)
end)

imgBtn2.MouseButton1Click:Connect(function()
	triggerImageJump(state2)
end)

local function applyMinimizeState()
	local activeW = isUnlocked and MAIN_W or KEY_W
	local activeH = isUnlocked and MAIN_H or KEY_H

	if minimized then
		contentFrame.Visible = false
		topFix.Visible = false
		divider.Visible = false
		mainFrame.Size = UDim2.new(0, activeW, 0, TOP_H)
	else
		contentFrame.Visible = true
		topFix.Visible = true
		divider.Visible = true
		mainFrame.Size = UDim2.new(0, activeW, 0, activeH)
	end
end

local function unlockMainGui()
	if isUnlocked then return end
	isUnlocked = true
	keyScreen.Visible = false
	mainHub.Visible = true
	animatePageIn(homePage)

	local curPos = mainFrame.Position
	mainFrame.Size = UDim2.new(0, MAIN_W, 0, MAIN_H)
	mainFrame.Position = UDim2.new(curPos.X.Scale, curPos.X.Offset - 45, curPos.Y.Scale, curPos.Y.Offset + 12)
	applyMinimizeState()
	playAppearEffect()
end

