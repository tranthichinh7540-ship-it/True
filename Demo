    local width = isUnlocked and MAIN_W or KEY_W
    local height = isUnlocked and MAIN_H or KEY_H

    if minimized then
        contentFrame.Visible = false
        divider.Visible = false
        topFix.Visible = false

        tween(mainFrame,0.2,{
            Size = UDim2.fromOffset(width,TOP_H)
        })
    else
        contentFrame.Visible = true
        divider.Visible = true
        topFix.Visible = true

        tween(mainFrame,0.2,{
            Size = UDim2.fromOffset(width,height)
        })
    end
end

