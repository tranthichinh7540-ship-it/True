local function createMotionState()
    return {
        offset = 0,
        phase = "idle",
        timer = 0,
        startOffset = 0
    }
end

local state1 = createMotionState()
local state2 = createMotionState()

local function triggerJump(state)
    state.phase = "rising"
    state.timer = 0
    state.startOffset = state.offset
end

local function stepMotion(state,dt)
    if state.phase == "rising" then
        state.timer += dt

        local alpha = math.clamp(
            state.timer/riseDuration,0,1
        )

        local eased = 1-(1-alpha)^2

        state.offset = state.startOffset
            +(jumpHeight-state.startOffset)*eased

        if alpha >= 1 then
            state.offset = jumpHeight
            state.phase = "falling"
            state.timer = 0
            state.startOffset = jumpHeight
        end

    elseif state.phase == "falling" then
        state.timer += dt

        local alpha = math.clamp(
            state.timer/fallDuration,0,1
        )

        local eased = alpha*alpha*(3-2*alpha)

        state.offset = state.startOffset*(1-eased)

        if alpha >= 1 then
            state.offset = 0
            state.phase = "idle"
            state.timer = 0
        end
    end
end

imgBtn1.MouseButton1Click:Connect(function()
    triggerJump(state1)
end)

imgBtn2.MouseButton1Click:Connect(function()
    triggerJump(state2)
end)

local function getAnchorY()
    if not isUnlocked then
        return TOP_H + (KEY_H-TOP_H-8)
            -(34+14+imgSize)
    else
        return -imgSize
    end
end

local renderConnection

renderConnection = RunService.RenderStepped:Connect(function(dt)
    if not screenGui.Parent then
        renderConnection:Disconnect()
        return
    end

    stepMotion(state1,dt)
    stepMotion(state2,dt)

    if minimized then
        imgBtn1.Visible = false
        imgBtn2.Visible = false
        return
    end

    imgBtn1.Visible = true
    imgBtn2.Visible = true

    local pos = mainFrame.AbsolutePosition
    local baseY = pos.Y + getAnchorY()

    imgBtn1.Position = UDim2.fromOffset(
        pos.X+20,
        math.floor(baseY-state1.offset+0.5)
    )

    imgBtn2.Position = UDim2.fromOffset(
        pos.X+78,
        math.floor(baseY-state2.offset+0.5)
    )
end)

