			gradToggleBtn.BackgroundColor3 = Color3.fromRGB(75, 165, 110)
		end
		for _, child in ipairs(presetRow:GetChildren()) do
			if child:IsA("TextButton") then
				child.BackgroundColor3 = (child == pBtn) and Color3.fromRGB(54, 60, 76) or Color3.fromRGB(27, 30, 38)
			end
		end
	end)
end

