-- Hàm tạo 2 ảnh nhỏ, sát nhau ở đầu bên trái, ngồi lên thanh key ngang (KHÔNG phát sound click)
local function createHeadImage(imageId, xOffset)
	local imgSize = 54
	local jumpHeight = 18

	local imgBtn = Instance.new("ImageButton")
	imgBtn.Size = UDim2.new(0, imgSize, 0, imgSize)
	local basePosition = UDim2.new(0, xOffset, 1, -(barHeight + barBottomMargin + imgSize))
	imgBtn.Position = basePosition
	imgBtn.BackgroundTransparency = 1
	imgBtn.BorderSizePixel = 0
	imgBtn.Image = "rbxassetid://" .. tostring(imageId)
	imgBtn.ScaleType = Enum.ScaleType.Fit
	imgBtn.AutoButtonColor = false
	imgBtn.ZIndex = 4
	imgBtn.Parent = contentFrame

	task.delay(0.8, function()
		if not imgBtn.IsLoaded then
			imgBtn.Image = "rbxthumb://type=Asset&id=" .. tostring(imageId) .. "&w=420&h=420"
		end
	end)

	local currentTween = nil
	local clickToken = 0

	imgBtn.MouseButton1Click:Connect(function()
		clickToken += 1
		local myToken = clickToken

		if currentTween then
			currentTween:Cancel()
		end

		local targetPos = UDim2.new(
			basePosition.X.Scale,
			basePosition.X.Offset,
			basePosition.Y.Scale,
			basePosition.Y.Offset - jumpHeight
		)

		local jumpInfo = TweenInfo.new(0.11, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		currentTween = TweenService:Create(imgBtn, jumpInfo, {
			Position = targetPos
		})
		currentTween:Play()

		task.delay(0.11, function()
			if myToken == clickToken then
				local fallInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				currentTween = TweenService:Create(imgBtn, fallInfo, {
					Position = basePosition
				})
				currentTween:Play()
			end
		end)
	end)
end

